{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "credentialsSource": "local"
      },
      "channel": "production"
    },
    "testflight": {
      "extends": "production",
      "channel": "preview"
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "production"
      },
      "ios": {
        "ascApiKeyPath": "./credentials/AuthKey_TQAZ5JQ2LT.p8",
        "ascApiKeyId": "TQAZ5JQ2LT",
        "ascApiKeyIssuerId": "614cfe80-272d-48d3-b61a-87b4b96adc14",
        "ascAppId": "6777929290",
        "appName": "Dharma \u2014 Hindu Mantras & Gita",
        "language": "en-US",
        "sku": "dharma-taraventures-001",
        "bundleIdentifier": "com.taraventures.dharma"
      }
    },
    "testflight": {
      "android": {
